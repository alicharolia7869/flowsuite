# FlowSuite Server & Database Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL / Prisma ORM
# For local development with Docker or local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsuite?schema=public
# For Production (Neon, Supabase, Railway, AWS RDS, etc.):
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Optional flag to force in-memory database store (used for local offline dev & automated unit tests):
FORCE_MEMORY_DB=false

# Redis Cache & Usage Counter Store
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=flowsuite_super_secret_jwt_access_token_key_2026
JWT_REFRESH_SECRET=flowsuite_super_secret_jwt_refresh_token_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Test Mode Billing
STRIPE_SECRET_KEY=sk_test_51MockKeyFlowSuiteBilling0000000000000000
STRIPE_WEBHOOK_SECRET=whsec_MockWebhookSecretFlowSuite0000000000000
STRIPE_SUCCESS_URL=http://localhost:5173/billing?session_id={CHECKOUT_SESSION_ID}&success=true
STRIPE_CANCEL_URL=http://localhost:5173/billing?cancelled=true

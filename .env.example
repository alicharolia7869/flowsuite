JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Test Mode Billing
STRIPE_SECRET_KEY=sk_test_51MockKeyFlowSuiteBilling0000000000000000
STRIPE_WEBHOOK_SECRET=whsec_MockWebhookSecretFlowSuite0000000000000
STRIPE_SUCCESS_URL=http://localhost:5173/billing?session_id={CHECKOUT_SESSION_ID}&success=true
